# multi_obj_revised.rt: A scene with multiple objects and lights, adjusted for dynamic lighting.

# Ambient lighting (slightly increased for brighter overall scene)
A   0.3     255,255,255

# Camera: [Viewpoint] [Orientation vector] [FOV]
# Adjusted view for better ground and object composition
C   0,10,60   0,-0.15,-1   60

# Light 1 (Yellow): [Light point] [Brightness ratio] [R,G,B color]
# High and to the left-front, dominant light
L   -35,50,20   0.8     255,255,0
# Light 2 (Red): [Light point] [Brightness ratio] [R,G,B color]
# Lower and to the right-back, secondary light for color contrast
L   35,15,35    0.6     255,0,0

# Floor plane (lighter gray)
pl  0,-10,0   0,1,0     180,180,180

# Three spheres
# Orange sphere (slightly moved)
sp  -15,-5,0     20        255,100,0
# Green sphere (moved forward and slightly to the right)
sp  5,0,15      30        0,255,100
# Blue sphere (moved back and to the left)
sp  20,-3,-10     15        0,100,255

# A tall cylinder
# Purple cylinder (moved to background, slightly taller)
cy  -30,0,-25   0,1,0     10         40         128,0,128