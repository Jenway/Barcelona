# Scene 8: Chrome and Glass
# Three spheres with distinct materials: matte, chrome, and glass.

A 0.1 255,255,255
C 0,15,-40 0,-0.2,1 60
# Two lights to create complex highlights
L -30,30,-30 0.7 255,255,255
L 30,20,-30 0.5 255,255,255

pl 0,0,0 0,1,0 100,100,100

# Sphere 1: Matte Red
sp -15,5,0 10 255,50,50 0.1,8

# Sphere 2: "Chrome" (gray diffuse, high reflectivity, white specular)
sp 0,5,0 10 180,180,180 255,255,255,256 0.6

# Sphere 3: "Glass" (light blue diffuse, very high reflectivity)
sp 15,5,0 10 200,200,255 1.0,512 0.9
