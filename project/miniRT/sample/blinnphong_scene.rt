# new_blinnphong_scene.rt: Scene demonstrating optional Blinn-Phong parameters.

A   0.2     255,255,255

C   0,20,50     0,-0.2,-1   60

L   -40,40,20     0.7      255,255,255
L   40,40,20      0.5      255,0,0

# Floor with high specularity (like polished tile)
# pl [Point] [Normal] [Diffuse_RGB] [Specular_RGB] [Shininess]
pl  0,-10,0       0,1,0     150,150,150   255,255,255   128.0

# Red sphere with strong, sharp highlight (like a billiard ball)
# sp [Center] [Diameter] [Diffuse_RGB] [Specular_RGB] [Shininess]
sp  -15,0,0       20        255,0,0       255,255,255   256.0

# Green sphere with low, broad highlight (like a matte rubber ball)
# sp [Center] [Diameter] [Diffuse_RGB] [Specular_RGB] [Shininess]
sp  15,0,0        20        0,255,0       100,100,100   10.0

# Blue cylinder with moderate highlight (like painted metal)
# cy [Center] [Axis] [Diameter] [Height] [Diffuse_RGB] [Specular_RGB] [Shininess]
cy  0,0,-20       0,1,0     10         30         0,0,255       200,200,255   64.0
